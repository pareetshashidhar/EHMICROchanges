# ==============================================================================
# SecureUpload Inspector - Example Environment Configuration (.env.example)
# ACADEMIC INTEGRITY NOTICE: Contains no real production secrets.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=production
# Debug mode must be 0 (disabled) by default for security
FLASK_DEBUG=0
PORT=5050
HOST=127.0.0.1
SECRET_KEY=example-academic-session-key-replace-with-cryptographic-random-value

# Storage & Security Settings
# Max request body size in bytes (12 MB default)
MAX_CONTENT_LENGTH=12582912
DATABASE_PATH=instance/secureupload.db
ACCEPTED_STORAGE_DIR=instance/accepted_uploads
QUARANTINE_DIR=instance/quarantine
AUDIT_LOG_PATH=instance/audit.log
